{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "game_data.json",
      "use": "@vercel/static"
    },
    {
      "src": "characters/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/server.js",
      "dest": "/server.js"
    },
    {
      "src": "/characters/(.*)",
      "dest": "/characters/$1"
    },
    {
      "src": "/game_data.json",
      "dest": "/game_data.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
